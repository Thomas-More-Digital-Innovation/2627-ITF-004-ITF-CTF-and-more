{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://localhost:3000",
      "http://localhost:5173"
    ],
    "AllowedMethods": [
      "GET",
      "POST"
    ],
    "AllowedHeaders": [
      "Content-Type"
    ],
    "ExposedHeaders": [],
    "AllowCredentials": true
  },
  "CtfCluster": {
    "CiliumVersion": "1.20.4",
    "ArgoCdVersion": "10.15.0",
    "Applications": [
      {
        "Name": "ctf-apps",
        "Namespace": "argocd",
        "Project": "default",
        "RepoUrl": "https://github.com/Thomas-More-Digital-Innovation/2627-ITF-004-ITF-CTF-and-more.git",
        "TargetRevision": "HEAD",
        "Path": "code/k8s/ctf",
        "DestinationServer": "https://kubernetes.default.svc",
        "DestinationNamespace": "ctf",
        "CreateNamespace": true,
        "AutomatedSync": true
      }
    ]
  },
  "AllowedHosts": "*"
}
