Opnsense__BaseUrl=https://your-opnsense-host
Opnsense__ApiKey=your-api-key
Opnsense__ApiSecret=your-api-secret
Opnsense__AllowInsecure=true
Opnsense__ParentInterface=vtnet1

Proxmox__Endpoint=https://your-proxmox-host:8006
Proxmox__Insecure=true
Proxmox__ApiToken=your-api-token
Proxmox__NodeNames__0=pve1
Proxmox__NodeNames__1=pve2
Proxmox__NodeNames__2=pve3
Proxmox__VnetName=envs
Proxmox__DatastoreId=datastore-id
Proxmox__Tags__0=pulumi

CtfCluster__GitlabUsername=gitlab-deploy-token-or-user
CtfCluster__GitlabToken=glpat-or-deploy-token
CtfCluster__CtfdAdminPassword=admin

CtfCluster__Domain=ctf.example.com
CtfCluster__AcmeEmail=admin@example.com
CtfCluster__AcmeStaging=true
CtfCluster__CloudflareApiToken=your-cloudflare-api-token

# Talos VM sizing (memory in MiB, disk in GiB); defaults shown
# CtfCluster__MasterCores=4
# CtfCluster__MasterMemoryMb=8192
# CtfCluster__MasterDiskGb=20
# CtfCluster__WorkerCores=8
# CtfCluster__WorkerMemoryMb=12288
# CtfCluster__WorkerDiskGb=80
